<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.EnhancedUI" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your light theme here. -->
        <item name="colorPrimary">@color/green</item>
    </style>
    <style name="Theme.EnhancedUI.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/green</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/icon</item>
        <item name="postSplashScreenTheme">@style/Theme.EnhancedUI</item>
    </style>


    <style name="Theme.EnhancedUI" parent="Base.Theme.EnhancedUI" />
</resources>